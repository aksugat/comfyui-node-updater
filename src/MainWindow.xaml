<Window x:Class="ComfyNodeUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComfyUI Node Updater"
        Width="1020" Height="740" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="app.ico">

    <Grid Margin="20,18,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="ComfyUI Node Updater" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Text}" />
                <TextBlock Text="Pick the nodes to update. Anything with local changes is left alone."
                           FontSize="12" Foreground="{StaticResource Dim}" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="10,7" MaxWidth="400">
                    <TextBlock Text="{Binding TargetDir}" FontSize="12" Foreground="{StaticResource Dim}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetDir}" />
                </Border>
                <Button x:Name="ChangeButton" Content="Change folder" Style="{StaticResource Flat}"
                        Margin="8,0,0,0" Click="ChangeFolder_Click" />
                <Button x:Name="CheckButton" Content="Check for updates" Style="{StaticResource Flat}"
                        Margin="8,0,0,0" Click="Check_Click" />
            </StackPanel>
        </Grid>

        <!-- toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Select all" Style="{StaticResource Link}" Click="SelectAll_Click" />
                <Button Content="Select none" Style="{StaticResource Link}" Margin="14,0,0,0" Click="SelectNone_Click" />
                <CheckBox x:Name="OnlyUpdatesBox" Style="{StaticResource Tick}" Content="Only nodes with updates"
                          Margin="22,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed" />
            </StackPanel>
            <TextBlock x:Name="Progress" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource Dim}" />
        </Grid>

        <!-- options -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="InstallReqBox" Style="{StaticResource Tick}"
                          Content="Install requirements.txt after updating (portable Python)"
                          Checked="InstallReq_Changed" Unchecked="InstallReq_Changed" />
                <TextBlock Text="{Binding PipLabel}" FontSize="11" Foreground="{StaticResource Dim}"
                           Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="430"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PipTooltip}" />
                <Button Content="settings" Style="{StaticResource Link}" Margin="4,0,0,0" Click="PipSettings_Click" />
            </StackPanel>
        </Grid>

        <!-- node list -->
        <Border Grid.Row="3" Background="{StaticResource CardAlt}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="12" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}" />
                </ScrollViewer.Resources>
                <ItemsControl x:Name="NodeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" Style="{StaticResource Tick}" VerticalAlignment="Top"
                                              Margin="0,2,0,0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding CanSelect}" />

                                    <StackPanel Grid.Column="1" Margin="12,0,14,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="disabled" FontSize="10" Foreground="{StaticResource Amber}"
                                                       Margin="8,2,0,0" Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DetailText}" FontSize="12" Foreground="{StaticResource Dim}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <Border Background="{Binding StatusBg}" CornerRadius="20" Padding="10,3"
                                                HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusFg}" />
                                        </Border>
                                        <TextBlock Text="{Binding ShaText}" FontFamily="Consolas" FontSize="11"
                                                   Foreground="#7D8CA1" HorizontalAlignment="Right" Margin="0,5,0,0" />
                                        <Button Content="Install requirements" Style="{StaticResource PipButton}"
                                                HorizontalAlignment="Right" Margin="0,5,0,0"
                                                Click="InstallRequirements_Click"
                                                Visibility="{Binding HasRequirements, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- activity -->
        <Grid Grid.Row="4" Margin="2,12,0,6">
            <TextBlock Text="Activity" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Dim}" />
            <Button Content="Clear" Style="{StaticResource Link}" HorizontalAlignment="Right" Click="ClearLog_Click" />
        </Grid>

        <Border Grid.Row="5" Background="{StaticResource CardAlt}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="10" Padding="10,6">
            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Dim}"
                     FontFamily="Consolas" FontSize="11" Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}" />
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0,2" />
                        <Setter Property="Foreground" Value="{StaticResource Dim}" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter Margin="{TemplateBinding Padding}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- footer -->
        <Grid Grid.Row="6" Margin="0,14,0,0">
            <TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Dim}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Open folder" Style="{StaticResource Flat}" Click="OpenFolder_Click" />
                <Button x:Name="UpdateButton" Content="Update selected" Style="{StaticResource Primary}"
                        Margin="8,0,0,0" Click="Update_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
